{
  "manifest_version": 3,
  "name": "JUFO Scholar",
  "version": "1.5.2",
  "description": "Shows JUFO publication forum levels on Google Scholar profile pages.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://scholar.google.com/*",
    "https://scholar.googleusercontent.com/*",
    "https://api.crossref.org/*",
    "https://jufo-rest.csc.fi/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "jufo-data.json",
        "default-mappings.json"
      ],
      "matches": [
        "https://scholar.google.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.chrome.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/citations*",
        "https://scholar.google.com/scholar*"
      ],
      "js": [
        "lib/browser-polyfill.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JUFO Scholar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
